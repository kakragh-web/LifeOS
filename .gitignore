# ─── Secrets & credentials (NEVER commit real values) ───
# Firebase configuration files are generated by `flutterfire configure`.
# The versions committed to this repo intentionally contain ONLY placeholder
# values (e.g. REPLACE_WITH_*) and act as templates for new contributors.
#
# IMPORTANT: After running `flutterfire configure` with your REAL Firebase
# project, do NOT commit the populated files. To keep your real credentials
# out of git without deleting the placeholder templates, run:
#   git update-index --assume-unchanged lib/core/firebase/firebase_options.dart
#   git update-index --assume-unchanged android/app/google-services.json
#   git update-index --assume-unchanged ios/Runner/GoogleService-Info.plist
#   git update-index --assume-unchanged android/app/src/main/res/values/google-services.xml
#
# If you prefer to fully ignore them instead of tracking placeholders, remove
# them from git (git rm --cached <file>) and uncomment the lines below:
# lib/core/firebase/firebase_options.dart
# android/app/google-services.json
# android/app/src/main/res/values/google-services.xml
# ios/Runner/GoogleService-Info.plist
# macos/Runner/GoogleService-Info.plist

# Environment / secret files
*.env
.env
.env.*
!.env.example
secrets.dart
lib/**/secrets.dart

